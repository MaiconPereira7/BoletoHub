# ==============================
# App
# ==============================
APP_NAME=BoletoHub
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key

# ==============================
# API
# ==============================
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=boletohub
POSTGRES_PASSWORD=boletohub
POSTGRES_DB=boletohub
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://boletohub:boletohub@db:5432/boletohub

# ==============================
# Redis
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ==============================
# Celery
# ==============================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================
# Scanner de e-mail (IMAP)
# ==============================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
EMAIL_SCAN_INTERVAL_MINUTES=15

# ==============================
# Autenticação JWT
# ==============================
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================
# Frontend
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
